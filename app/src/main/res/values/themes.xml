<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Echo" parent="Theme.Material3Expressive.DynamicColors.DayNight.NoActionBar">
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">
            ?colorSkyCanvas
        </item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">
            @drawable/art_splash_anim
        </item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="s">900</item>
        <item name="android:windowSplashScreenBehavior" tools:targetApi="TIRAMISU">
            icon_preferred
        </item>
        <item name="android:windowSplashScreenBrandingImage" tools:targetApi="s">
            @drawable/art_brand
        </item>
        <item name="android:colorBackground">?colorSkyCanvas</item>
        <item name="snackbarStyle">@style/EchoSnackBar</item>
        <item name="android:dialogTheme">@style/EchoDialog</item>
        <item name="materialAlertDialogTheme">@style/EchoAlertDialog</item>
        <item name="bottomSheetDialogTheme">@style/EchoBottomSheetDialog</item>
        <item name="appBarLayoutStyle">@style/EchoAppBarLayout</item>
        <item name="actionButtonStyle">@style/EchoActionButton</item>
        <item name="collapsingToolbarLayoutStyle">@style/EchoCollapsingBar</item>
        <item name="cardViewStyle">@style/EchoCardView</item>
        <item name="tabStyle">@style/EchoTabLayout</item>
        <item name="circularProgressIndicatorStyle">@style/EchoCircularProgressIndicator</item>
        <item name="linearProgressIndicatorStyle">@style/EchoLinearProgressIndicator</item>

        <item name="materialButtonStyle">@style/PortalPrimaryActionButton</item>
        <item name="materialButtonOutlinedStyle">@style/OutlinedButton</item>

        <item name="echoBackground">?colorSkyCanvas</item>
        <item name="navBackground">?colorWhiteFrostTranslucent</item>

        <item name="itemCoverSize">96dp</item>
        <item name="itemCorner">@dimen/radius_cards</item>

        <!-- Portal Colors Mapping -->
        <item name="colorSkyCanvas">@color/color_sky_canvas</item>
        <item name="colorWhiteFrost">@color/color_white_frost</item>
        <item name="colorWhiteFrostTranslucent">@color/color_white_frost_translucent</item>
        <item name="colorWhiteFrostBubble">@color/color_white_frost_bubble</item>
        <item name="colorInk">@color/color_ink</item>
        <item name="colorCharcoalText">@color/color_charcoal_text</item>
        <item name="colorMutedAsh">@color/color_muted_ash</item>
        <item name="colorPortalBlue">@color/color_portal_blue</item>
        <item name="colorBlueAura">@color/color_blue_aura</item>

        <!-- Material 3 Color Mappings -->
        <item name="colorPrimary">?colorPortalBlue</item>
        <item name="colorOnPrimary">?colorWhiteFrost</item>
        <item name="colorPrimaryContainer">?colorBlueAura</item>
        <item name="colorOnPrimaryContainer">?colorInk</item>

        <item name="colorSecondary">?colorCharcoalText</item>
        <item name="colorOnSecondary">?colorWhiteFrost</item>
        <item name="colorSecondaryContainer">?colorWhiteFrostTranslucent</item>
        <item name="colorOnSecondaryContainer">?colorInk</item>

        <item name="colorSurface">?colorSkyCanvas</item>
        <item name="colorOnSurface">?colorInk</item>
        <item name="colorSurfaceVariant">?colorWhiteFrost</item>
        <item name="colorOnSurfaceVariant">?colorCharcoalText</item>
        <item name="colorOutline">?colorInk</item>

        <!-- Material 3 Typography Mappings -->
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Portal.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Portal.Body</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Portal.Heading</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Portal.Display</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Portal.Body</item>

        <!-- Material 3 Shape Mappings -->
        <item name="shapeAppearanceSmallComponent">@style/PortalButtonShape</item>
        <item name="shapeAppearanceMediumComponent">@style/EchoCardViewShape</item>
        <item name="shapeAppearanceLargeComponent">@style/PortalBottomSheetShape</item>

        <!-- Portal Fonts Mapping -->
        <item name="fontSansSerif">sans-serif</item>
        <item name="fontPerfectlyNineties">sans-serif</item>
        <item name="fontInter">sans-serif</item>

        <item name="textAppearancePortalBody">@style/TextAppearance.Portal.Body</item>
        <item name="textAppearancePortalHeading">@style/TextAppearance.Portal.Heading</item>
        <item name="textAppearancePortalDisplay">@style/TextAppearance.Portal.Display</item>
    </style>

    <style name="Default" parent="Base.Theme.Echo">
        <item name="navBarForeground">?colorPortalBlue</item>
        <item name="navBarBackground">?colorWhiteFrost</item>
    </style>

    <style name="Amoled" parent="Default">
    </style>

    <style name="BigCover" parent="Default">
        <item name="itemCoverSize">128dp</item>
    </style>

    <style name="AmoledBigCover" parent="Amoled">
        <item name="itemCoverSize">128dp</item>
    </style>
</resources>
